{
  "name": "lowpo11y",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LOWPO11Y — free-first asset library, browser tools and scene builder for PS1/PS2/N64-inspired and low-poly game developers.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "demo:generate": "tsx scripts/generate-demo-content.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset-local.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "vercel-build": "tsx scripts/vercel-build.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@electric-sql/pglite": "^0.5.10",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.56.1",
