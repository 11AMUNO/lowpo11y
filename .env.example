# LOWPO11Y configuration. Copy to .env.local for local overrides.
# With NOTHING set, the app runs fully locally: an embedded Postgres (PGlite)
# and file storage under LOWPO11Y_DATA_DIR. Never commit real values.
# Production setup, step by step: docs/DEPLOYMENT.md

# ---- Site -------------------------------------------------------------------
# Public base URL (used for canonical links, sitemaps and upload URLs).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shown on the contact page. Optional.
NEXT_PUBLIC_CONTACT_EMAIL=

# Secret for signing upload/download links and hashing client addresses.
# Required in production: at least 32 random characters
# (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))").
APP_SECRET=

# Enables /auth/setup to create the first admin on a hosted database.
# Any long random string. Setup locks itself once an admin exists.
SETUP_TOKEN=

# ---- Local development -------------------------------------------------------
LOWPO11Y_DATA_DIR=.data/dev

# ---- Database (Supabase or any Postgres 15+) ---------------------------------
# Leave empty for the embedded local database. For Supabase use the
# "Transaction pooler" connection string (port 6543).
DATABASE_URL=
DATABASE_POOL_MAX=5

# ---- Object storage ------------------------------------------------------------
# local | r2
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Private bucket: staging uploads and everything unpublished.
R2_PRIVATE_BUCKET=
# Optional public bucket for published files, served from a custom domain.
R2_PUBLIC_BUCKET=
R2_PUBLIC_BASE_URL=
# Only for S3-compatible test servers (e.g. MinIO). Leave empty for Cloudflare.
R2_ENDPOINT=

# Largest single upload accepted by the admin, in bytes (default 512 MB).
MAX_UPLOAD_BYTES=536870912

# ---- Development seed (local only) ---------------------------------------------
SEED_ADMIN_EMAIL=admin@lowpo11y.local
SEED_ADMIN_PASSWORD=lowpo11y-local-admin
